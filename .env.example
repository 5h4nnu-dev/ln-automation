# Copy to .env and edit. Environment variables override config.json.
# Never put LinkedIn credentials in this file; log in manually in the browser.

# --- Course / browser -------------------------------------------------
COURSE_URL=https://www.linkedin.com/learning/example-course
# Optional batch list (CSV or .txt). When set, this takes precedence over COURSE_URL.
# COURSES_FILE=./courses.txt
BROWSER_PROFILE=./browser_profile
HEADLESS=false

# --- Playback ---------------------------------------------------------
PLAYBACK_SPEED=2.0
MAX_PLAYBACK_SPEED=2.0
POLL_INTERVAL=1.0
STALL_TIMEOUT=25
PLAYBACK_TIMEOUT=14400
COMPLETION_TIMEOUT=120

# --- Behaviour --------------------------------------------------------
AUTO_START=true
AUTO_NAVIGATE=true
AUTO_RESUME=true
ASSESSMENT_ENABLED=true
ASSESSMENT_WAIT_TIMEOUT=300
AUTH_TIMEOUT=300
MAX_RETRIES=3
MAX_CONSECUTIVE_FAILURES=3
VERIFY_VIA_COURSE_PAGE=true

# --- Persistence / logging -------------------------------------------
DATABASE_PATH=./data/progress.db
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_JSON=false

# Optional JSON selector overrides
# SELECTORS_PATH=./selectors.json
